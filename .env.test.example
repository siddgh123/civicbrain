# =============================================================================
# CivicBrain - E2E / test-account template.  Copy to `.env.test` (git-ignored) and fill in.
#   pwsh:  Copy-Item .env.test.example .env.test
# Used by: scripts/dev/seed-e2e.ps1 (backend profile `e2e-seed` creates the fixed accounts in
# the E2E database through the real services, so passwords are Argon2id-hashed and TOTP secrets
# encrypted exactly like production), by tests/smoke/smoke_flow.py (reads this file itself, prints no secrets)
# and by Playwright (playwright.config.ts loads it with Node 24's
# built-in process.loadEnvFile('../.env.test') - no dotenv package).
# These accounts exist ONLY in DB_E2E_NAME (civicbrain_e2e). Never reuse these values anywhere else.
# Generate values:
#   passwords (12-128 chars):  pwsh -NoProfile -File scripts\dev\new-secret.ps1 -Kind password
#   TOTP secrets (base32):     pwsh -NoProfile -File scripts\dev\new-secret.ps1 -Kind base32
# =============================================================================

E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://127.0.0.1:8080
E2E_MAILPIT_URL=http://127.0.0.1:8025

# Fixed accounts (docs/08_TEST_PLAN.md §2)
E2E_ADMIN_EMAIL=admin@test.local
E2E_ADMIN_PASSWORD=REPLACE_ME
E2E_ADMIN_TOTP_SECRET=REPLACE_ME_BASE32

E2E_OFFICER_ROAD_EMAIL=officer.road@test.local
E2E_OFFICER_ROAD_PASSWORD=REPLACE_ME
E2E_OFFICER_ROAD_TOTP_SECRET=REPLACE_ME_BASE32

E2E_OFFICER_W3_EMAIL=officer.w3@test.local
E2E_OFFICER_W3_PASSWORD=REPLACE_ME
E2E_OFFICER_W3_TOTP_SECRET=REPLACE_ME_BASE32

E2E_CONTRACTOR_EMAIL=contractor.patil@test.local
E2E_CONTRACTOR_PASSWORD=REPLACE_ME

# a second firm (work type WATER) for "other contractor gets 404" tests
E2E_CONTRACTOR_OTHER_EMAIL=contractor.other@test.local
E2E_CONTRACTOR_OTHER_PASSWORD=REPLACE_ME

E2E_STAFF_EMAIL=staff.patil@test.local
E2E_STAFF_PASSWORD=REPLACE_ME

E2E_CITIZEN1_EMAIL=citizen1@test.local
E2E_CITIZEN1_PASSWORD=REPLACE_ME
E2E_CITIZEN1_PHONE=+919000000001

E2E_CITIZEN2_EMAIL=citizen2@test.local
E2E_CITIZEN2_PASSWORD=REPLACE_ME
E2E_CITIZEN2_PHONE=+919000000002

# Fixed points (inside ward number 1 = ward_id 21 / 40 m away / outside the TDMC boundary /
# 445 m south, still ward 1, 516 m from the boundary - checked against gis/tdmc_wards_clean_v2.geojson)
E2E_POINT_IN=18.7440,73.6760
E2E_POINT_NEAR=18.7442,73.6763
E2E_POINT_OUT=18.7700,73.7500
E2E_POINT_FAR=18.7400,73.6760
