# =============================================================================
# CivicBrain - environment template.  Copy to `.env` (git-ignored) and fill in LOCAL values.
#   pwsh:  Copy-Item .env.example .env
# Rules (docs/07_SECURITY.md §5):
#   * `.env` is never committed, never opened by the Antigravity agent, never pasted in chat.
#   * While the agent is building: dummy/local values only (Mailpit, WHATSAPP_PROVIDER=log).
#     Real Gmail / Meta / Twilio credentials are added by a human only for P5 checks and P12.
#   * Generate every secret below with:   pwsh -NoProfile -File scripts\dev\new-secret.ps1
#     (prints 32 random bytes as base64; use a different value for each key).
#   * Values containing spaces or `#` must be quoted. Use SINGLE quotes for Windows paths
#     ('C:\Program Files\...'): in double quotes python-dotenv turns \b, \t, \n ... into control characters.
#   * An EMPTY value (KEY=) is NOT set at all (Windows cannot hold empty environment variables). Every key
#     that may be empty needs a default in application.yml (e.g. ${SMTP_USER:}) and in the pydantic Settings.
# The backend fails fast at startup if a required value is missing (@Validated @ConfigurationProperties);
# the AI service does the same (pydantic-settings).  scripts/dev/check-env.ps1 checks this file too.
# =============================================================================

# ---------- PostgreSQL 18 + PostGIS 3.6 ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicbrain
# Spring datasource (JDBC form of the three values above)
DB_URL=jdbc:postgresql://localhost:5432/civicbrain
# API role created by db/tools/create_roles_template.sql (least privilege)
DB_USER=civicbrain_app
DB_PASSWORD=change-me-app-role-password
# AI worker / FastAPI role
DB_AI_USER=civicbrain_ai
DB_AI_PASSWORD=change-me-ai-role-password
# Database owner: used ONLY by Flyway (spring.flyway.user/password) and by the human scripts
# (backup-db, seed-e2e, verify-all DB tests). In local dev this is `postgres`.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change-me-postgres-password
# Folder with psql.exe / pg_dump.exe (EDB installer does NOT add it to PATH)
PG_BIN='C:\Program Files\PostgreSQL\18\bin'
# Test databases (never the real one): SQL tests + AI integration tests / Playwright E2E stack
DB_TEST_NAME=civicbrain_test
DB_E2E_NAME=civicbrain_e2e

# ---------- Auth & crypto (docs/07_SECURITY.md §1) ----------
# HS256 key for access tokens, >= 32 random bytes, base64
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTES
JWT_ISSUER=civicbrain
JWT_AUDIENCE=civicbrain-web
# HMAC key for e-mail OTP codes (codes are stored only as HMAC-SHA256)
OTP_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
# AES-256-GCM key that encrypts officer/admin TOTP secrets at rest (exactly 32 bytes, base64)
TOTP_ENC_KEY=REPLACE_WITH_BASE64_32_BYTES
# HS256 key for the 60-second service JWT (backend -> AI API admin endpoints, aud=civicbrain-ai)
AI_SERVICE_JWT_SECRET=REPLACE_WITH_BASE64_32_BYTES

# ---------- Web app ----------
# The URL people open in the browser. Used for links in e-mails/WhatsApp and for the Origin check
# on /auth/refresh and /auth/logout.  Phone testing: set it to the https://....trycloudflare.com URL
# printed by start-tunnel.ps1 and restart the backend.
APP_BASE_URL=http://localhost:5173
# Extra allowed Origins (comma separated, dev only), e.g. keep the laptop working while APP_BASE_URL
# points at the tunnel.  Leave EMPTY on the demo machine.
APP_EXTRA_ORIGINS=http://localhost:5173
# Photos (outside the web root, git-ignored). Absolute path.
STORAGE_ROOT=C:\dev\civicbrain\storage
# Spring profile: dev | demo   (e2e is set by start-e2e.ps1, e2e-seed by seed-e2e.ps1)
SPRING_PROFILES_ACTIVE=dev
# Labour cost per worker-hour in INR. Leave EMPTY until TDMC gives a rate: the estimate then shows
# "rate not set" instead of inventing a number (docs/06_AI_PIPELINE.md §2, cost).
LABOUR_RATE_PER_HOUR=

# ---------- E-mail (dev = Mailpit, no auth, no TLS) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM="CivicBrain TDMC <no-reply@civicbrain.local>"
# Demo with Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=true SMTP_USER=<project gmail>
#                  SMTP_PASSWORD=<16-char app password>  SMTP_FROM="CivicBrain TDMC <project gmail>"

# ---------- WhatsApp (docs/04_API_CONTRACT.md §9 webhooks, docs/13_DEMO_AND_DEPLOY.md §1) ----------
# log = write the message to the application log only (always during the build)
WHATSAPP_PROVIDER=log
# Meta WhatsApp Cloud API (test number, max 5 registered recipient phones)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
META_WA_API_VERSION=v26.0
# Twilio WhatsApp sandbox (fallback)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886

# ---------- AI worker + FastAPI ----------
AI_API_HOST=127.0.0.1
AI_API_PORT=8001
AI_SERVICE_URL=http://127.0.0.1:8001
# Road times for the optimizer: haversine = straight-line x 1.3 at 20 km/h (7-day MVP) | osrm (Phase 2)
ROUTING_MODE=haversine
# 127.0.0.1, not localhost: Docker publishes OSRM on IPv4 only and Windows tries ::1 first (slow)
OSRM_URL=http://127.0.0.1:5000
# Absolute paths; files and SHA-256 listed in ai-service/models/MANIFEST.json
YOLO_WEIGHTS=C:\dev\civicbrain\ai-service\models\yolov8s_civicbrain.onnx
MODELS_DIR=C:\dev\civicbrain\ai-service\models
# sentence-transformers model folder (downloaded once, then used offline)
TEXT_EMBEDDING_MODEL_DIR=C:\dev\civicbrain\ai-service\models\all-MiniLM-L6-v2
HF_HUB_OFFLINE=1
# Ultralytics: never pip-install or download at runtime, keep its settings file inside the project (not %APPDATA%)
YOLO_AUTOINSTALL=false
YOLO_OFFLINE=true
YOLO_CONFIG_DIR=C:\dev\civicbrain\ai-service\.ultralytics
# Unique per running worker process (shows up in jobs.locked_by)
WORKER_ID=laptop1-worker1
WORKER_POLL_SECONDS=2
# BLUR_IMAGE jobs (face blur for public photos) - switch on in P7 after the YuNet file is in MODELS_DIR
BLUR_ENABLED=false
LOG_LEVEL=INFO
